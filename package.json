{
  "name": "artefact-cataloguer",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "description": "AI-assisted museum cataloguing desktop app",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "predev": "node scripts/update-check.mjs",
    "dev": "vite",
    "prebuild": "node scripts/update-check.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "update:deps": "node scripts/update-check.mjs --update",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "build:win-arm64": "tauri build --target aarch64-pc-windows-msvc",
    "build:win-x64": "tauri build --target x86_64-pc-windows-msvc",
    "build:win-all": "npm run build:win-arm64 && npm run build:win-x64",
    "build:linux": "tauri build --bundles appimage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.53.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
